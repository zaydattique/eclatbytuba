# ── Database (required for production; enables durable catalog/orders/settings) ──
DATABASE_URL="postgresql://user:password@localhost:5432/eclat_by_tuba?schema=public"

# ── Auth (REQUIRED in production — no demo defaults) ──
NEXTAUTH_SECRET="generate-a-strong-secret-here"
AUTH_SECRET="generate-a-strong-secret-here"
NEXTAUTH_URL="http://localhost:3000"
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="use-a-long-random-password"

# Optional: only if something still calls web admin paths cross-origin
# ADMIN_API_SECRET="long-random-string"

# ── App URLs ──
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"

# ── Object storage (R2 / S3 / MinIO) — optional; falls back to local public/uploads ──
# S3_BUCKET="eclat-media"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_PUBLIC_URL="https://media.yourdomain.com"
# S3_FORCE_PATH_STYLE="true"

# ── Durable rate limiting (Upstash Redis REST) — optional; falls back to memory ──
# UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN=""

# ── Stripe (placeholder — usually N/A in Pakistan) ──
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ── Email (Resend) ──
RESEND_API_KEY=""

# ── Analytics ──
NEXT_PUBLIC_GA_ID=""
