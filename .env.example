# ── Database ──
# Production: REQUIRED. Must be a remote Postgres URL (not localhost).
# Development: optional. If unset, apps use in-memory catalog/orders for local demo.
DATABASE_URL="postgresql://user:password@localhost:5432/eclat_by_tuba?schema=public"

# Force in-memory even when DATABASE_URL is set (development only)
# ALLOW_IN_MEMORY=1

# ── Auth (REQUIRED in production — no demo defaults) ──
# Production: AUTH_SECRET (or NEXTAUTH_SECRET), ADMIN_EMAIL, ADMIN_PASSWORD required.
# Development: if unset, auth package uses local-only demo defaults (never in production).
NEXTAUTH_SECRET="generate-a-strong-secret-here"
AUTH_SECRET="generate-a-strong-secret-here"
NEXTAUTH_URL="http://localhost:3000"
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="use-a-long-random-password"

# Optional: defense-in-depth for residual web admin-style paths
# ADMIN_API_SECRET="long-random-string"

# ── App URLs ──
# Production: set to your real domains (canonical / OG / sitemap source of truth)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"

# ── Stripe (placeholder — usually N/A in Pakistan) ──
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ── Email (Resend) ──
RESEND_API_KEY=""
# EMAIL_FROM="Éclat by Tuba <orders@yourdomain.com>"

# ── Analytics ──
NEXT_PUBLIC_GA_ID=""
# NEXT_PUBLIC_META_PIXEL_ID=""
